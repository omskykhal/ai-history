  "type": "module",
  "private": true,
  "author": {
    "name": "Yang",
    "email": "omskykhal@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omskykhal/ai-history.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-hooks",
    "claude-code-plugin",
    "codex",
    "codex-cli",
    "grok",
    "kimi",
    "cursor",
    "hooks",
    "session-memory",
    "persistent-memory",
    "markdown"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run-tests.mjs && node test/run-agent-tests.mjs && node test/run-cursor-tests.mjs",
    "install-hooks": "node install.mjs --install",
    "status": "node install.mjs --status"
  }
}
